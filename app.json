{
  "expo": {
    "name": "Steadier",
    "slug": "steadier",
    "scheme": "steadier",
    "version": "0.1.3",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "4",
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.steadier"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "15aab9cc-4c4a-4df2-9cc5-b250b4c7c19e"
      }
    }
  }
}
